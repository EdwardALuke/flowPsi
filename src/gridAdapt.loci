namespace flowPsi {
  using std::cout ;
  using std::endl ;
  using std::cerr ;
  using std::vector;
  using std::map ;
  using Loci::redistributeStore ;
  using Loci::getC2PGlobal ;
  

  //--------------------------------------------------------------------------
  // Setup vars file variables for mesh adaptation

  $type maxAdaptSteps param<int> ;
  $type adaptMode param<string> ;
  $type adaptMode2D Constraint ;
  $type adaptMode3D Constraint ;
  $type adaptMinEdgeLength param<double> ;
  $type adaptGeometryEdgeLength param<double> ;
  $type adaptGeometryLayers param<double> ;
  $type adaptFaceFold param<double> ;
  $type adaptBalanceType param<int> ;
  $type adaptFrequency param<int> ;
  $type adaptStart param<int> ;
  $type adaptSensitivity param<double> ;
  $type coarsenSensitivity param<double> ;
  $type adaptSensor param<flowPsi::list_input>  ;

  $rule default(maxAdaptSteps) {
    $maxAdaptSteps = 0 ;
  }
  /// adaptMode can be 'isotropic', 'anisotropic', or '2D'
  $rule default(adaptMode) {
    $adaptMode = "anisotropic" ;
  }

  $rule constraint(adaptMode2D,adaptMode3D<-adaptMode) {
    if($adaptMode == "2D") {
      $adaptMode2D = ~EMPTY ;
      $adaptMode3D = EMPTY ;
    } else {
      $adaptMode2D = EMPTY ;
      $adaptMode3D = ~EMPTY ;
    }
  }
  /// Sets minimum edge length allowed for refinement
  $rule default(adaptMinEdgeLength) { $adaptMinEdgeLength = 1e-6 ; }

  /// Sets target edge length for overset geometry refinement
  $rule optional(adaptGeometryEdgeLength) { }

  /// Sets thickness of derefinement levels for overset geometry refinement
  $rule default(adaptGeometryLayers)  { $adaptGeometryLayers = 8 ;  }

  /// Sets face folding criterion to disable refining highly twisted faces
  $rule default(adaptFaceFold) { $adaptFaceFold = 1.5708 ; }

  /// Sets mesh balancing method used to balance refinement levels
  $rule default(adaptBalanceType)  { $adaptBalanceType = 0 ; }

  /// Sets how frequently in solver iterations before mesh adaptation will be
  /// evaluated
  $rule optional(adaptFrequency)  { $adaptFrequency = 100 ;  }

  /// Disables refinement until this timestep is reached
  $rule default(adaptStart)  { $adaptStart = 100 ; }

  /// Sets error threshold for refinement
  $rule default(adaptSensitivity)  { $adaptSensitivity = 1.0 ;  }


  /// Sets error threshold for derefinement
  $rule default(coarsenSensitivity) { $coarsenSensitivity = 0.5 ;  }

  /// Selects error metrics to use for refinement
  $rule optional(adaptSensor)  { $adaptSensor.namelist = "" ;  }
  

  $type maxAdaptCellCount param<double> ;

  /// Maximum number of cells in adaption phase in millions of cells.
  /// This is a floating point number so fractional values are allowed.
  /// A negative value disables this feature.
  $rule default(maxAdaptCellCount) {
    $maxAdaptCellCount=-1. ;
  }

  
  $type numCells param<double> ;
  /// Find the number of cells in the current mesh, used to estimate
  /// how many cells can be refined.
  $rule unit(numCells),constraint(UNIVERSE) { $numCells=0 ; }
  $rule apply(numCells<-vol)[Loci::Summation],constraint(geom_cells), prelude {
    *$numCells += double(seq.size())*1.0e-6 ;
  } ;

  /// Estimate of how many cells can be refined before the maximum cell count
  /// is reached
  $type maxRefineCellCount param<int> ;

  /// Compute how many cells can be refined  by assuming that 1 cell becomes 8
  /// for 3-D refinement and 1 cell becomes 4 for 2-D refinement.
  $rule singleton(maxRefineCellCount<-numCells,maxAdaptCellCount,adaptMode) {
    double factor = 1.e6/7.0 ;
    if($adaptMode == "2D")
      factor = 1.e6/3.0 ;
    // default no limit
    $maxRefineCellCount = std::numeric_limits<int>::max()  ;
    // If we are already above the cell count limit, we cannot mark any cell
    // for refinement, otherwise find out how many cells can be added to the
    // current mesh to reach limit and estimate how many refined cells will
    // achieve that size.
    if($maxAdaptCellCount > 0)
      $maxRefineCellCount = int(max($maxAdaptCellCount-$numCells,0.0)*factor) ;
    $[Once] {
      cout << "maxAdaptCellCount=" << $maxAdaptCellCount
           << ", numCells=" << $numCells
           << ", maxRefineCellCount=" << $maxRefineCellCount
           << endl ;
    }
  }
       
  $type componentGeometryList blackbox<vector<Loci::CPTR<geometry_type> > > ;
  $type componentID store<int> ;
  $type nblank store<chem::byte_t> ;

  //--------------------------------------------------------------------------
  // Code for cell based mesh adaptation flags

    
  $type cellMaxEdgeLength store<real> ;
  $type cellAdaptMask store<int> ;
  $type cellMeanCount param<int> ;
  $type cellMean(X) param<double> ;
  $type cellSigmaSq(X) param<double> ;
  $type cellRefFlag store<int> ;
  $type refineCell(X) store<int> ;

  $rule unit(cellMaxEdgeLength),constraint(geom_cells) {
    $cellMaxEdgeLength = 0 ;
  }

  $rule apply((cl,cr)->cellMaxEdgeLength<-area,face2node->pos)[Loci::Maximum],
    constraint(adaptMode3D,(cl,cr)->geom_cells) {
    real len = 0 ;
    int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i) {
      int ip = ((i+1)==fsz)?0:i+1 ;
      real elen = norm($face2node[ip]->$pos-$face2node[i]->$pos) ;
      join($cl->$cellMaxEdgeLength,elen) ;
      join($cr->$cellMaxEdgeLength,elen) ;
      len += elen ; 
    }
    real estlen = 4.*$area.sada/len ;
    join($cl->$cellMaxEdgeLength,estlen) ;
    join($cr->$cellMaxEdgeLength,estlen) ;
  }

  $rule apply(ci->cellMaxEdgeLength<-area,face2node->pos)[Loci::Maximum],
    constraint(adaptMode2D,ci->geom_cells) {
    // normals aligned with the z direction will be considered for 2D
    if(fabs(fabs($area.n.z)-1.0) < 1e-8) {
      real len = 0 ;
      int fsz = $face2node.size() ;
      for(int i=0;i<fsz;++i) {
	int ip = ((i+1)==fsz)?0:i+1 ;
	real elen = norm($face2node[ip]->$pos-$face2node[i]->$pos) ;
	join($ci->$cellMaxEdgeLength,elen) ;
	len += elen ; 
      }
      join($ci->$cellMaxEdgeLength,4.*$area.sada/len) ;
    }
  }
      
  $rule pointwise(cellAdaptMask<-cellMaxEdgeLength,adaptMinEdgeLength) {
    $cellAdaptMask = 0 ;
    if($cellMaxEdgeLength < $adaptMinEdgeLength)
      $cellAdaptMask = 1 ;
  }

  $type adaptMaskDistance param<real> ;

  $rule optional(adaptMaskDistance) {
    $adaptMaskDistance = 0.0 ;
  }

  $rule pointwise(wall::cellAdaptMask<-cellMaxEdgeLength,adaptMinEdgeLength,
		  adaptMaskDistance,dist_noslip) {
    $cellAdaptMask = 0 ;
    if($cellMaxEdgeLength < $adaptMinEdgeLength)
      $cellAdaptMask = 1 ;
    if($dist_noslip < $adaptMaskDistance)
      $cellAdaptMask = 1 ;
  }

  $rule unit(cellMeanCount),constraint(geom_cells) {
    $cellMeanCount = 0 ;
  }

  $rule apply(cellMeanCount<-vol)[Loci::Summation],constraint(geom_cells) {
    join($cellMeanCount,1) ;
  }

  $type Xf store<float> ;
  $rule unit(cellMean(Xf)),constraint(Xf,geom_cells) {
    $cellMean(Xf) = 0 ;
  }
  $rule apply(cellMean(Xf)<-Xf,cellMeanCount)[Loci::Summation] {
    join($cellMean(Xf),static_cast<double>($Xf)/
         static_cast<double>($cellMeanCount)) ;
  }

  $rule unit(cellSigmaSq(Xf)), constraint(Xf,geom_cells) {
    $cellSigmaSq(Xf) = 0 ;
  }
  $rule apply(cellSigmaSq(Xf)<-Xf,cellMean(Xf),cellMeanCount)[Loci::Summation] {
    double delta = $Xf-$cellMean(Xf) ;
    double term = delta*delta/($cellMeanCount-1) ;
    join($cellSigmaSq(Xf),term) ;
  }

  /// Scaled Error Estimate which is a non-dimensional value which is how many
  /// standard deviations the error is above (or below) the mean.  Negative
  /// numbers indicate that the error is below the mean.  When combining
  /// multiple error contributions, the maximum estimate represents the error
  /// in the cell.
  $type totScaledError store<float> ;
  $type ERRVAR store<float> ;

  // The unit assumes very small error (identity of the maxiumum operator)
  $rule unit(totScaledError),constraint(geom_cells) {
    $totScaledError = -1e30 ;
  }

  /// Error variables are added through the parametric variable adaptSensor(X)
  /// which is created in the fact database when the vars file is read and
  /// the adaptSensor variable is specified.
  $rule apply(totScaledError<-ERRVAR,cellMean(ERRVAR),
              cellSigmaSq(ERRVAR))[Loci::Maximum],
  parametric(adaptSensor(ERRVAR)) {
    float sigma = sqrt($cellSigmaSq(ERRVAR)) ;
    float err_scaled = ($ERRVAR-$cellMean(ERRVAR))/(sigma+1e-30) ;
    join($totScaledError,err_scaled) ;
  }

  /// If refining all cells at the current adapt sensitivity would cause
  /// the total mesh size to exceed the specifed limit, we will adjust the
  /// adaption sensitivity parameter so that the target number of refined
  /// cells is met.
  $type limitedAdaptSensitivity blackbox<double> ;
  $rule unit(limitedAdaptSensitivity), constraint(geom_cells) {
    $limitedAdaptSensitivity = 0 ;
  }
  
  $rule apply(limitedAdaptSensitivity<-totScaledError,adaptSensitivity,
                  cellAdaptMask,maxRefineCellCount)[Loci::NullOp],
    option(disable_threading),prelude {
    // by default the user specified sensitivity is used.
    double sensitivity = *$adaptSensitivity ;
    *$limitedAdaptSensitivity = sensitivity ;
    // Count how many cells will be refined at the current sensitivity level.
    int cnt = 0 ;
    entitySet domain = entitySet(seq) ;
    FORALL(domain,ii) {
      if($cellAdaptMask[ii] == 0 &&
         $totScaledError[ii] > sensitivity)
        cnt++ ;
    } ENDFORALL ;

    // Gather all of the refined sizes
    vector<int> refsizes(Loci::MPI_processes,0) ;
    MPI_Allgather(&cnt,1,MPI_INT,&refsizes[0],1,MPI_INT,MPI_COMM_WORLD) ;
    int totsize = 0 ;
    for(int i=0;i<Loci::MPI_processes;++i)
      totsize += refsizes[i] ;
    int targetRefineCells = *$maxRefineCellCount ;
    // If the number of refined cells exceed the target, then we need 
    // to find the sensitivity that will match the target
    if(totsize > targetRefineCells) {
      // sort the errors to identify how much error will achieve limit
      //
      // errorList contains error estimates for all cells that are currently
      // selected for refinement
      vector<double> errorList(cnt) ;
      cnt = 0 ;
      FORALL(domain,ii) {
        if($cellAdaptMask[ii] == 0 &&
           $totScaledError[ii] > sensitivity)
          errorList[cnt++] = $totScaledError[ii] ;
      } ENDFORALL ;
      // Use parallel sort to sort his error list.
      Loci::parSampleSort(errorList,std::greater<double>(),MPI_COMM_WORLD) ;
      // Find the entry at the location of this array that is given
      // by the cell count target
      cnt = errorList.size() ;
      MPI_Allgather(&cnt,1,MPI_INT,&refsizes[0],1,MPI_INT,MPI_COMM_WORLD) ;
      int remainingCells = targetRefineCells ;
      // Find out which processor has the pivot error value
      int source_rank = 0 ;
      for(int i=0;i<Loci::MPI_processes;++i) {
        if(remainingCells < refsizes[i]) {
          source_rank = i ;
          break ;
        }
        remainingCells -= refsizes[i] ;
      }
      // If we are the processor that contains the target error, grab it
      // out of the array
      if(Loci::MPI_rank == source_rank)
        sensitivity = errorList[min<int>(remainingCells,errorList.size()-1)] ;
      // and broadcast to other processors
      MPI_Bcast(&sensitivity,1,MPI_DOUBLE,source_rank,MPI_COMM_WORLD) ;
      // Update sensitivity to one that meets target refinement level
      *$limitedAdaptSensitivity = sensitivity ;
    }
      
  } ;
  
  // Compute refinement flag
  $rule unit(cellRefFlag),constraint(geom_cells,adaptSensor) {
    $cellRefFlag = -1 ;
  }

  /// Compute cell refinement flag (1 means refine cell, -1 means derefine cell)
  /// This is achieved by comparing the estimated error to the sensitivity
  /// settings input by user (where the refinement sensitivity has been limited
  /// to prevent excessive mesh sizes)
  $rule apply(cellRefFlag<-totScaledError,limitedAdaptSensitivity,coarsenSensitivity)[Loci::Maximum] {
    int flag = 0 ;
    if($totScaledError > $limitedAdaptSensitivity)
      flag = 1 ;
    if($totScaledError < -$coarsenSensitivity)
      flag = -1 ;
    join($cellRefFlag,flag) ;
  }

  $rule apply(cellRefFlag<-adaptGeometryLayers,adaptGeometryEdgeLength,
	      componentGeometryList,componentID,iblank,cellcenter,
	      cellMaxEdgeLength)[Loci::Maximum] {
    int cid = $componentID ;
    const vector<Loci::CPTR<geometry_type> > &geom = $componentGeometryList ;
    int csz = geom.size() ;
    if(cid >= 0 && cid < csz && geom[cid] == 0) {
      // Find closest distance
      real dist = 1e30 ;
      for(int i=0;i<csz;++i) {
	if(geom[i]!= 0) {
	  dist = min(dist,geom[i]->distToSurface($cellcenter)) ;
	}
      }
      real Llay = $adaptGeometryEdgeLength*$adaptGeometryLayers ;
      dist = max<real>(dist-1.25*Llay-.5*$cellMaxEdgeLength,0.0) ;

      real length = $adaptGeometryEdgeLength*(1.+dist/Llay) ;
      int command = 0 ;
      if($cellMaxEdgeLength > length) 
	command = 1 ;
      if($cellMaxEdgeLength < .5*length)
	command = -1 ;
      if($iblank == 3)
	command = -1 ;
      join($cellRefFlag,command) ;
    }
  }

  $type cellRefFlagMask store<int> ;
  $rule pointwise(cellRefFlagMask<-cellAdaptMask,cellRefFlag) {
    $cellRefFlagMask = $cellRefFlag ;
    if($cellRefFlag > 0 && $cellAdaptMask != 0)
      $cellRefFlagMask = 0 ;
  }
  $rule pointwise(OUTPUT{n,it}<-cellRefFlagMask{n,it},cellcenter{n,it}),conditional(do_adapt{n,it}),option(disable_threading), prelude {
    entitySet dom = entitySet(seq) ;

    store<char> flags ;
    flags.allocate(dom) ;
    FORALL(dom,ii) {
      int fl =$cellRefFlagMask{n,it}[ii] ;
      flags[ii] = ((0==fl)?0:((fl > 0)?1:2)) ;
    } ENDFORALL ;
    

    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem("c2p") ;
    if(ptr != 0) {
      Loci::DataXFER_DB.deleteItem("c2p") ;
      Loci::DataXFER_DB.deleteItem("c2pglobal") ;
    }
    
    fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
    int offset = 0 ;
    Loci::storeRepP vardist = Loci::Local2FileOrder(flags.Rep(),dom,offset,
                                                    dist,
                                                    MPI_COMM_WORLD) ;
    Loci::DataXFER_DB.insertItem("refineTag",vardist) ;
    
  } ;

  //---diagnostics
  $type cellRefFlagf store<real> ;
  $rule pointwise(cellRefFlagf<-cellRefFlag) {$cellRefFlagf = $cellRefFlag;}

  $type totScaledErrorf store<real> ;
  $rule pointwise(totScaledErrorf<-totScaledError) { $totScaledErrorf=$totScaledError ; }
  
  OUTPUT_SCALAR("cell2nodeMax(cellRefFlagf)",refFlag) ;
  OUTPUT_SCALAR("cell2nodeMax(totScaledErrorf)",combinedErrorFactor) ;
  OUTPUT_SCALAR("cell2nodeMax(cellMaxEdgeLength)",cellMaxEdgeLength) ;

  $type scalarCellError(XE,YE) store<float> ;
  $type XE store<real> ;
  $type YE store<real> ;

  $rule unit(scalarCellError(XE,YE)),constraint(geom_cells) {
    $scalarCellError(XE,YE) = 0 ;
  }
  $rule apply((cl,cr)->scalarCellError(XE,YE)<-XE,YE)[Loci::Maximum],
    constraint((cl,cr)->geom_cells,XE,YE) {
    float val = realToFloat(fabs($XE-$YE)) ;
    join($cl->$scalarCellError(XE,YE),val) ;
    join($cr->$scalarCellError(XE,YE),val) ;
  }

  $type vect3d_cell_error(XV,YV) store<float> ;
  $type XV store<vect3d> ;
  $type YV store<vect3d> ;

  $rule unit(vect3d_cell_error(XV,YV)),constraint(geom_cells) {
    $vect3d_cell_error(XV,YV) = 0 ;
  }
  $rule apply((cl,cr)->vect3d_cell_error(XV,YV)<-XV,YV)[Loci::Maximum],
    constraint((cl,cr)->geom_cells,XV,YV) {
    float val = realToFloat(norm($XV-$YV)) ;
    join($cl->$vect3d_cell_error(XV,YV),val) ;
    join($cr->$vect3d_cell_error(XV,YV),val) ;
  }
  

  //--------------------------------------------------------------------------
  // Code for computing node based error estimators and saving nodal refine
  // tag


  // Temperature error
  $type Terror store<float> ;
  $rule pointwise(Terror<-scalarCellError(leftsP(temperature,Zero),rightsP(temperature,Zero))), inplace(Terror|scalarCellError(leftsP(temperature,Zero),rightsP(temperature,Zero))),prelude {} ;

  // Density error
  $type Rerror store<float> ;
  $rule pointwise(Rerror<-scalarCellError(leftsP(rho,Zero),rightsP(rho,Zero))),inplace(Rerror|scalarCellError(leftsP(rho,Zero),rightsP(rho,Zero))),prelude {} ;

  // Pressure error
  $type Perror store<float> ;
  $rule pointwise(Perror<-scalarCellError(leftsP(gagePressure,minPg),rightsP(gagePressure,minPg))),inplace(Perror|scalarCellError(leftsP(gagePressure,minPg),rightsP(gagePressure,minPg))),prelude {} ;

  // Velocity error
  $type Uerror store<float> ;
  $rule pointwise(Uerror<-vect3d_cell_error(leftv3d(u),rightv3d(u))),inplace(Uerror|vect3d_cell_error(leftv3d(u),rightv3d(u))),prelude {} ;
		  

  //--------------------------------------------------------------------------
  // Adapt cycle control
  $type refCount param<int> ;
  $type do_adapt param<bool> ;
  $type refineLevel param<int> ;

  $rule unit(refCount),constraint(UNIVERSE) {
    $refCount = 0 ;
  }

  $rule apply(refCount<-cellRefFlagMask)[Loci::Summation] {
    int cnt = ($cellRefFlagMask > 0)?1:0 ;
    join($refCount,cnt) ;
  }

  $type derefCount param<int> ;

  $rule unit(derefCount),constraint(UNIVERSE) {
    $derefCount = 0 ;
  }

  $rule apply(derefCount<-cellRefFlagMask)[Loci::Summation] {
    int cnt = ($cellRefFlagMask < 0)?1:0 ;
    join($derefCount,cnt) ;
  }

  $rule singleton(do_adapt{n,it}<- ncycle{n},stime{n,it},$it{n,it},refCount{n,it},newtonMaxIter,timeSteppingMode,adaptFrequency,adaptStart,refineLevel,maxAdaptSteps) {
    $do_adapt{n,it} = false ;

    int ncyc = $ncycle{n}+1 ;
    int newton_iter = $timeSteppingMode==1?($newtonMaxIter):1 ;
    if($$it{n,it}+1 == newton_iter && 
       $refineLevel < $maxAdaptSteps &&
       ncyc >= $adaptStart && 
       (ncyc%$adaptFrequency) == 0) {
      $do_adapt{n,it} = true ;
      param<int> nc ; 
      *nc = ncyc ;
      Loci::DataXFER_DB.insertItem("ncycle",nc.Rep()) ;
      param<real> st ;
      *st = $stime{n,it} ;
      Loci::DataXFER_DB.insertItem("stime",st.Rep()) ;

      param<bool> adaptCycle ;
      *adaptCycle = true ;
      Loci::DataXFER_DB.insertItem("adaptCycle",adaptCycle.Rep()) ;
    }
  }


  //--------------------------------------------------------------------------
  // Interpolation I/O parts

  $rule pointwise(OUTPUT{n,it}<-componentTransformMap{n,it}), conditional(do_adapt{n,it}),option(disable_threading),prelude {
    blackbox<map<string,vector<Loci::componentXform> > > tmp ;
    tmp.Rep()->allocate(~EMPTY) ;
    *tmp = *($componentTransformMap{n,it}) ;
    Loci::DataXFER_DB.insertItem("componentXform",tmp.Rep()) ;
  } ;


  $rule pointwise(OUTPUT{n,it}<-gagePressure{n,it},temperature{n,it},u{n,it}),constraint(geom_cells{n,it}),conditional(do_adapt{n,it}),option(disable_threading), prelude {
    entitySet dom = entitySet(seq) ;

    store<double> pg ;
    store<double> t ;
    store<vect3d> vel ;
    pg.allocate(dom) ;
    t.allocate(dom) ;
    vel.allocate(dom) ;
    FORALL(dom,ii) {
      pg[ii] = realToDouble($gagePressure{n,it}[ii]) ;
      t[ii] = realToDouble($temperature{n,it}[ii]) ;
      vel[ii] = realToDouble($u{n,it}[ii]) ;
    } ENDFORALL ;

    fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
    Map l2f ;
    getL2FMap(l2f,dom, dist) ;
    vector<int> splits ;
    FindSimpleDistribution(dom, l2f, splits,MPI_COMM_WORLD) ;

    Loci::storeRepP vardist = 0;
    redistributeStore(vardist,pg.Rep(),dom,l2f,splits,MPI_COMM_WORLD) ;
    Loci::DataXFER_DB.insertItem("pgrestart",vardist) ;
    vardist = 0 ;
    redistributeStore(vardist,t.Rep(),dom,l2f,splits,MPI_COMM_WORLD) ;
    Loci::DataXFER_DB.insertItem("trestart",vardist) ;
    vardist = 0 ;
    redistributeStore(vardist,vel.Rep(),dom,l2f,splits,MPI_COMM_WORLD) ;
    Loci::DataXFER_DB.insertItem("urestart",vardist) ;
  } ;

  $type nodalScalarMax(X) store<float> ;
  $rule unit(nodalScalarMax(X)),constraint(pos) {
    $nodalScalarMax(X) = std::numeric_limits<float>::lowest() ;
  }

  $type X store<real> ;
  $type X_f store<real> ;
  $rule apply(face2node->nodalScalarMax(X)<-(cl,cr)->X)[Loci::Maximum] {
    const real Xf = max($cl->$X,$cr->$X) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMax(X),realToFloat(Xf)) ;
  }
  $rule apply(face2node->nodalScalarMax(X)<-X_f)[Loci::Maximum],constraint(ci->X) {
    const real Xf = $X_f ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMax(X),realToFloat(Xf)) ;
  }

  $type nodalScalarMin(X) store<float> ;
  $rule unit(nodalScalarMin(X)),constraint(pos) {
    $nodalScalarMin(X) = std::numeric_limits<float>::max() ;
  }
  $type X store<real> ;
  $type X_f store<real> ;
  $rule apply(face2node->nodalScalarMin(X)<-(cl,cr)->X)[Loci::Minimum] {
    const real Xf = min($cl->$X,$cr->$X) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMin(X),realToFloat(Xf)) ;
  }
  $rule apply(face2node->nodalScalarMin(X)<-X_f)[Loci::Minimum],constraint(ci->X) {
    const real Xf = $X_f ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMin(X),realToFloat(Xf)) ;
  }

  template <class T> struct Maximumv3d {
    void operator()(T &res ,const T &arg)
    {
      res.x = ::max(res.x,arg.x) ;
      res.y = ::max(res.y,arg.y) ;
      res.z = ::max(res.z,arg.z) ;
    }
  } ;  
  template <class T> struct Minimumv3d {
    void operator()(T &res ,const T &arg)
    {
      res.x = ::min(res.x,arg.x) ;
      res.y = ::min(res.y,arg.y) ;
      res.z = ::min(res.z,arg.z) ;
    }
  } ;  

  $type nodalv3dMax(X) store<vector3d<float> > ;
  $rule unit(nodalv3dMax(X)),constraint(pos) {
    float m = std::numeric_limits<float>::lowest() ;
    $nodalv3dMax(X) = vector3d<float>(m,m,m) ;
  }
  $type V store<vect3d> ;
  $type V_f store<vect3d> ;
  $rule apply(face2node->nodalv3dMax(V)<-(cl,cr)->V)[Maximumv3d] {
    const vector3d<float> Vf(realToFloat(max($cl->$V.x,$cr->$V.x)),
			     realToFloat(max($cl->$V.y,$cr->$V.y)),
			     realToFloat(max($cl->$V.z,$cr->$V.z))) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMax(V),Vf) ;
  }
  $rule apply(face2node->nodalv3dMax(V)<-V_f)[Maximumv3d],constraint(ci->V) {
    const vector3d<float> Vf = realToFloat($V_f) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMax(V),Vf) ;
  }

  $type nodalv3dMin(V) store<vector3d<float> > ;
  $rule unit(nodalv3dMin(V)),constraint(pos) {
    float m = std::numeric_limits<float>::max() ;
    $nodalv3dMin(V) = vector3d<float>(m,m,m) ;
  }
  $type V store<vect3d> ;
  $type V_f store<vect3d> ;
  $rule apply(face2node->nodalv3dMin(V)<-(cl,cr)->V)[Minimumv3d] {
    const vector3d<float> Vf(realToFloat(min($cl->$V.x,$cr->$V.x)),
			     realToFloat(min($cl->$V.y,$cr->$V.y)),
			     realToFloat(min($cl->$V.z,$cr->$V.z))) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMin(V),Vf) ;
  }
  $rule apply(face2node->nodalv3dMin(V)<-V_f)[Minimumv3d],constraint(ci->V) {
    const vector3d<float> Vf = realToFloat($V_f) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMin(V),Vf) ;
  }

  $type cellMaxVal(X) store<float> ;
  $type cellMinVal(X) store<float> ;
  $rule pointwise(cellMaxVal(X)<-(upper,lower)->face2node->nodalScalarMax(X)) {
    float Xv = std::numeric_limits<float>::lowest() ;    
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
	Xv = max(Xv,$upper[i]->$face2node[j]->$nodalScalarMax(X)) ;
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
	Xv = max(Xv,$lower[i]->$face2node[j]->$nodalScalarMax(X)) ;
    }
    $cellMaxVal(X) = Xv ;
  }

  $rule pointwise(cellMinVal(X)<-(upper,lower)->face2node->nodalScalarMin(X)) {
    float Xv = std::numeric_limits<float>::max() ;    
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
	Xv = min(Xv,$upper[i]->$face2node[j]->$nodalScalarMin(X)) ;
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
	Xv = min(Xv,$lower[i]->$face2node[j]->$nodalScalarMin(X)) ;
    }
    $cellMinVal(X) = Xv ;
  }
  $type cellMaxVal3d(X) store<vector3d<float> >;
  $type cellMinVal3d(X) store<vector3d<float> > ;
  $rule pointwise(cellMaxVal3d(X)<-(upper,lower)->face2node->nodalv3dMax(X)) {
    float m = std::numeric_limits<float>::lowest() ;    
    vector3d<float> Xv(m,m,m) ;
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
	Xv.x = max(Xv.x,$upper[i]->$face2node[j]->$nodalv3dMax(X).x) ;
	Xv.y = max(Xv.y,$upper[i]->$face2node[j]->$nodalv3dMax(X).y) ;
	Xv.z = max(Xv.z,$upper[i]->$face2node[j]->$nodalv3dMax(X).z) ;
      }
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
	Xv.x = max(Xv.x,$lower[i]->$face2node[j]->$nodalv3dMax(X).x) ;
	Xv.y = max(Xv.y,$lower[i]->$face2node[j]->$nodalv3dMax(X).y) ;
	Xv.z = max(Xv.z,$lower[i]->$face2node[j]->$nodalv3dMax(X).z) ;
      }
    }
    $cellMaxVal3d(X) = Xv ;
  }

  $rule pointwise(cellMinVal3d(X)<-(upper,lower)->face2node->nodalv3dMin(X)) {
    float m = std::numeric_limits<float>::max() ;    
    vector3d<float> Xv(m,m,m) ;

    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
	Xv.x = min(Xv.x,$upper[i]->$face2node[j]->$nodalv3dMin(X).x) ;
	Xv.y = min(Xv.y,$upper[i]->$face2node[j]->$nodalv3dMin(X).y) ;
	Xv.z = min(Xv.z,$upper[i]->$face2node[j]->$nodalv3dMin(X).z) ;
      }
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
	Xv.x = min(Xv.x,$lower[i]->$face2node[j]->$nodalv3dMin(X).x) ;
	Xv.y = min(Xv.y,$lower[i]->$face2node[j]->$nodalv3dMin(X).y) ;
	Xv.z = min(Xv.z,$lower[i]->$face2node[j]->$nodalv3dMin(X).z) ;
      }
    }
    $cellMinVal3d(X) = Xv ;
  }

  $type cellMaxRadius store<float> ;
  $rule pointwise(cellMaxRadius<-cellcenter,(upper,lower)->face2node->pos) {
    double rmax2 = 0 ;
    const vect3d c = $cellcenter ;
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
	const vect3d dv = $upper[i]->$face2node[j]->$pos-c ;
	rmax2 = max(rmax2,realToDouble(dot(dv,dv))) ;
      }
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
	const vect3d dv = $lower[i]->$face2node[j]->$pos-c ;
	rmax2 = max(rmax2,realToDouble(dot(dv,dv))) ;
      }
    }
    $cellMaxRadius = sqrt(rmax2) ;
  }

  $rule pointwise(OUTPUT{n,it}<-
		  lower->cl->cellcenter{n,it},
		  upper->cr->cellcenter{n,it},
		  boundary_map->facecenter{n,it},
		  lower->cl->fileNumber(geom_cells),
		  upper->cr->fileNumber(geom_cells),
		  cellcenter{n,it},vol{n,it}),
    constraint(geom_cells{n,it}),conditional(do_adapt{n,it}),
    option(disable_threading),
    prelude {
    entitySet dom = entitySet(seq) ;

    store<int> count_dv ; // number of deltas including boundary faces
    store<int> count_iv ; // number of deltas only interior cells ;
    count_dv.allocate(dom) ;
    count_iv.allocate(dom) ;
    int lmxiv= 0, lmxdv=0 ;
    FORALL(dom,ii) {
      count_iv[ii] = $upper[ii].size()+$lower[ii].size() ;
      count_dv[ii] = count_iv[ii] + $boundary_map[ii].size() ;
      lmxiv = max(lmxiv,count_iv[ii]) ;
      lmxdv = max(lmxdv,count_dv[ii]) ;
    } ENDFORALL ;

    int mn = 0 ;
    int mnl = std::numeric_limits<int>::max() ;
    FORALL(dom,ii) {
      mnl = min(mnl,$fileNumber(geom_cells)[ii]) ;
    } ENDFORALL ;
    mn=mnl ;
    MPI_Allreduce(&mnl,&mn,1,MPI_INT,MPI_MIN,MPI_COMM_WORLD) ;

    multiStore<int> gradCells  ;
    multiStore<vector3d<double> > deltas ;
    gradCells.allocate(count_iv) ;
    deltas.allocate(count_dv) ;
    FORALL(dom,ii) {
      vect3d center = $cellcenter{n,it}[ii] ;
      const int usz = $upper[ii].size() ;
      for(int i=0;i<usz;++i) {
	const int cell = $cr[$upper[ii][i]] ;
	gradCells[ii][i] = $fileNumber(geom_cells)[cell]-mn ;
	deltas[ii][i] = ($cellcenter{n,it}[cell]-center) ;
      }
      const int lsz = $lower[ii].size() ;
      for(int i=0;i<lsz;++i) {
	const int cell = $cl[$lower[ii][i]] ;
	gradCells[ii][usz+i] = $fileNumber(geom_cells)[cell]-mn ;
	deltas[ii][usz+i] = ($cellcenter{n,it}[cell]-center) ;
      }
      const int bsz = $boundary_map[ii].size() ;
      for(int i=0;i<bsz;++i) {
	const int face = $boundary_map[ii][i] ;
	deltas[ii][usz+lsz+i] = ($facecenter{n,it}[face]-center) ;
      }
    } ENDFORALL ;

    fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;

    Map l2f ;
    getL2FMap(l2f,dom, dist) ;
    vector<int> splits ;
    FindSimpleDistribution(dom, l2f, splits,MPI_COMM_WORLD) ;

    {
      Loci::storeRepP vardist = 0;
      redistributeStore(vardist,gradCells.Rep(),dom,l2f,splits,MPI_COMM_WORLD) ;
      Loci::DataXFER_DB.insertItem("gradCells",vardist) ;
    }
      
    {
      Loci::storeRepP vardist = 0;
      redistributeStore(vardist,deltas.Rep(),dom,l2f,splits,MPI_COMM_WORLD) ;
      Loci::DataXFER_DB.insertItem("deltas",vardist) ;
    }

    store<double> volw ;
    volw.allocate(dom) ;

    FORALL(dom,ii) {
      volw[ii] = ($vol{n,it}[ii]) ;
    } ENDFORALL ;

    Loci::storeRepP vardist = 0  ;
    redistributeStore(vardist,volw.Rep(),dom,l2f,splits,MPI_COMM_WORLD) ;
    Loci::DataXFER_DB.insertItem("vol",vardist) ;
  } ;


  $type refineRestart param<int> ;
  $type componentName_X blackbox<string> ;
  $type adaptRestartXform_X blackbox<vector<componentXform> > ;
  $rule blackbox(adaptRestartXform_X<-componentName_X,refineRestart),
    parametric(volumeTag(X)),prelude {
    vector<componentXform> xform ;
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem("componentXform") ;
    if(ptr != 0) {
      blackbox<map<string,vector<componentXform> > > tmp ;
      tmp = ptr ;
      map<string,vector<componentXform> >::const_iterator mi ;
      mi = tmp->find(*$componentName_X) ;
      if(mi != tmp->end()) {
	xform = mi->second ;
      } else {
	cerr << "Unable to find component " << *$componentName_X << " when looking up adapt restart component transforms!" << endl ;
      }
    }
    *$adaptRestartXform_X = xform ;
  } ;


  $type pos_ic store<vect3d> ;
  $rule pointwise(priority::priority::pos_ic<-pos,refineRestart,adaptRestartXform_X),
    constraint(componentNodes_X),
    parametric(volumeTag(X)) {
    const vector<componentXform> &xform = $adaptRestartXform_X ;
      vect3d xpos = $pos ;
    for(size_t i=0;i<xform.size();++i)
      xpos = xform[i].applyXform(xpos) ;
    $pos_ic = xpos ;
  }

  $type cellcenterxform store<vect3d> ;
  $rule pointwise(cellcenterxform<-cellcenter,adaptRestartXform_X),
    constraint(volumeTag(X)), parametric(volumeTag(X)) {
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem("componentXform") ;
    const vector<componentXform> &xform = $adaptRestartXform_X ;
    vect3d xpos = $cellcenter ;
    for(size_t i=0;i<xform.size();++i)
      xpos = xform[i].applyXform(xpos) ;
    $cellcenterxform = xpos ;
  }



  using Loci::dataPartitionP ;
  using Loci::createPartition ;
  using Loci::gatherCommSchedule ;
  
  // Component Motion
  $type componentMotionState_X_ic blackbox<vector<real> > ;
  $type componentMotionState_X_next blackbox<vector<real> > ;
  $type motionBehavior_X blackbox<Loci::CPTR<Loci::motionType> > ;
  
  $rule pointwise(OUTPUT{n,it}<-componentMotionState_X_next{n,it},
                  componentName_X{n,it}),
  constraint(componentMotion,motionBehavior_X),
  parametric(volumeTag(X)), conditional(do_adapt{n,it}),
  prelude {
    string name = string("componentMotionState_") +
      *$componentName_X{n,it} ;
    param<vector<real> > motionsave ;
    *motionsave = *$componentMotionState_X_next{n,it} ;
    Loci::DataXFER_DB.insertItem(name,motionsave.Rep()) ;
  } ;

  $rule apply(componentMotionState_X_ic<-refineRestart,modelName,componentName_X)[Loci::NullOp], parametric(volumeTag(X)), prelude {
    string name = string("componentMotionState_") +
      *$componentName_X ;
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem(name) ;
    if(ptr != 0) {
      param<vector<real> > tmp;
      tmp.setRep(ptr) ;
      *$componentMotionState_X_ic = *tmp ;
    } else {
      cerr << "cannot find '" <<name << "' in XFER DB!" << endl ;
      Loci::Abort() ;
    }      
  } ;


  $type AMRInterpolationMapping blackbox<Loci::AMRinterpolation> ;

  $rule blackbox(AMRInterpolationMapping<-refineRestart,cellcenterxform,
                 vol,Pambient), prelude {
    multiStore<int> gradCells  ;
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem("gradCells") ;
    if(ptr == 0) {
      cerr << "gradCells not in DB!" << endl ;
    }
    gradCells = ptr ;
    multiStore<vector3d<double> > deltas ;
    ptr = Loci::DataXFER_DB.getItem("deltas") ;
    if(ptr == 0) {
      cerr << "deltas not in DB!" << endl ;
    }
    deltas = ptr ;

    store<double> volw ;
    volw = Loci::DataXFER_DB.getItem("vol") ;
    // Convert c2pg to the correct numbering
    store<pair<int,int> > c2pg ;
    c2pg = getC2PGlobal(*Loci::exec_current_fact_db) ;

    $AMRInterpolationMapping->
      setupRefinementMapping(c2pg,volw,gradCells,deltas,$cellcenterxform,$vol,
                             *Loci::exec_current_fact_db) ;

    volw.allocate(EMPTY) ;
    gradCells.allocate(EMPTY) ;
    deltas.allocate(EMPTY) ;
    Loci::DataXFER_DB.deleteItem("vol") ;
    Loci::DataXFER_DB.deleteItem("gradCells") ;
    Loci::DataXFER_DB.deleteItem("deltas") ;
    Loci::DataXFER_DB.deleteItem("centers") ;
  } ;

  template <typename T> struct unit_traits {
    static T unit() {return 0 ; } ;
  } ;
  template <> struct unit_traits<double> {
    static double unit() { return 0.0; }
  } ;
  template <> struct unit_traits<vector3d<double> > {
    static vector3d<double> unit() { return vector3d<double>(0.0,0.0,0.0) ; }
  } ;

  $type refineRestart param<int> ;
  $rule pointwise(priority::gagePressure_ic<-refineRestart,AMRInterpolationMapping),option(disable_threading),prelude {
    store<double> pgprev ;
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem("pgrestart") ;
    if(ptr == 0)
      cerr << "pgrestart not in DB!" << endl ;

    pgprev = ptr ;

    $AMRInterpolationMapping->interpolateData(pgprev,$gagePressure_ic) ;
    Loci::DataXFER_DB.deleteItem("pgrestart") ;
  } ;
    
  $rule pointwise(priority::temperature_ic<-refineRestart,
                  AMRInterpolationMapping),option(disable_threading),prelude {
    store<double> tprev ;
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem("trestart") ;
    if(ptr == 0)
      cerr << "trestart not in DB!" << endl ;

    tprev = ptr ;

    $AMRInterpolationMapping->interpolateData(tprev,$temperature_ic) ;

    Loci::DataXFER_DB.deleteItem("trestart") ;
  } ;

  $rule pointwise(priority::u_ic<-refineRestart,AMRInterpolationMapping),
  option(disable_threading),prelude {
    store<vector3d<double> > uprev ;
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem("urestart") ;
    if(ptr == 0)
      cerr << "trestart not in DB!" << endl ;

    uprev = ptr ;

    $AMRInterpolationMapping->interpolateData(uprev,$u_ic) ;

    Loci::DataXFER_DB.deleteItem("urestart") ;
  } ;

  $type ic_stime param<real> ; //computing time ;
  $type ic_ncycle param<int> ; //starting cycle number ;
 
  $rule apply(ic_ncycle<-timeSteppingMode)[Loci::Maximum], prelude {
    Loci::storeRepP nc = Loci::DataXFER_DB.getItem("ncycle") ;
    if(nc != 0) {
      param<int> ncyc ;
      ncyc = nc ;
      *$ic_ncycle = max(*$ic_ncycle,*ncyc) ;
      Loci::DataXFER_DB.deleteItem("ncycle") ;
    }
  } ;
  $rule apply(ic_stime<-dtmax)[Loci::Maximum], prelude {
    Loci::storeRepP sc = Loci::DataXFER_DB.getItem("stime") ;
    if(sc != 0) {
      param<real> stime ;
      stime = sc ;
      *$ic_stime = max(*$ic_stime,*stime) ;
    }
  } ;

  $type X store<real> ;
  $type C Constraint ;
  $type scalarTransportName(X) param<std::string> ;
  // Scalar transport equation adapt restart
  $rule pointwise(OUTPUT{n,it}<-
		  X{n,it},scalarTransportName(X)),
    constraint(geom_cells{n,it},C{n,it}),conditional(do_adapt{n,it}),
    parametric(scalarTransportP(X,C)), option(disable_threading),
    prelude {
    string name = string("scalar_")+*$scalarTransportName(X) ;
    store<real> xtmp ;
    entitySet dom = entitySet(seq) ;
    xtmp.allocate(dom) ;
    FORALL(dom,ii) {
      xtmp[ii] = $X{n,it}[ii] ;

    } ENDFORALL ;

    fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
    Map l2f ;
    getL2FMap(l2f,dom, dist) ;
    vector<int> splits ;
    FindSimpleDistribution(dom, l2f, splits,MPI_COMM_WORLD) ;

    Loci::storeRepP vardist = 0;
    redistributeStore(vardist,xtmp.Rep(),dom,l2f,splits,MPI_COMM_WORLD) ;
    if(vardist == 0) {
      cerr << "vardist is null for '" << name << "'" << endl ;
    }
    Loci::DataXFER_DB.insertItem(name,vardist) ;
  } ;

  // scalar transport restart on adapt
  $type X_ic store<real> ;
  $rule pointwise(priority::X_ic<-refineRestart,AMRInterpolationMapping,
                  scalarTransportName(X)),
    constraint(geom_cells,C),
    parametric(scalarTransportP(X,C)), option(disable_threading),
    prelude {
    string name = string("scalar_")+*$scalarTransportName(X) ;

    store<real> Xtmp ;
    Loci::storeRepP ptr = Loci::DataXFER_DB.getItem(name) ;
    if(ptr == 0)
      cerr << name << " not in DB!" << endl ;

    Xtmp = ptr ;

    
    $AMRInterpolationMapping->interpolateData(Xtmp,$X_ic) ;

    // Release the interpolation data
    Xtmp.allocate(EMPTY) ;
    Loci::DataXFER_DB.deleteItem(name) ;
  } ;

}
